<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>agentprobe</AssemblyName>
    <RootNamespace>AgentProbe</RootNamespace>
    <Version>0.2.5</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>agentprobe.ico</ApplicationIcon>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- One self-contained native exe: copy it anywhere and run, no .NET install needed. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\agent-guide.md" LogicalName="agent-guide.md" />
    <EmbeddedResource Include="Controller\dashboard.html" LogicalName="dashboard.html" />
    <!-- Pretendard, SIL Open Font License 1.1 (see Controller\fonts\OFL.txt) -->
    <EmbeddedResource Include="Controller\fonts\*.woff2" LogicalName="font/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the .NET heap of another process for the `heap` tool (MIT licence). It is compiled into the exe; the
         runtime's own debugging library (the DAC) is loaded from the tested PC's .NET installation, nothing is downloaded. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
  </ItemGroup>

</Project>
